# ─────────────────────────────────────────────────────────────────
# Stage 1: Builder — compile utxo-vmd Rust binary
# ─────────────────────────────────────────────────────────────────
FROM rust:1-bookworm AS builder

WORKDIR /app

# Install system dependencies for linking (needed by wasmtime, secp256k1, libp2p)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    clang \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Cache dependency compilation by copying manifests first (layer caching trick)
COPY Cargo.toml Cargo.lock ./
COPY packages/core-vm/Cargo.toml packages/core-vm/Cargo.toml
COPY packages/node/Cargo.toml packages/node/Cargo.toml

# Create dummy source files to satisfy cargo check for dep caching
RUN mkdir -p packages/core-vm/src packages/node/src && \
    echo "pub fn _placeholder() {}" > packages/core-vm/src/lib.rs && \
    echo "fn main() {}" > packages/node/src/main.rs

# Build deps only (cached as a layer if Cargo.toml hasn't changed)
RUN cargo build --release -p utxo-vmd 2>&1 || true

# Now copy actual source code
COPY packages/core-vm/src/ packages/core-vm/src/
COPY packages/node/src/ packages/node/src/

# Touch source to invalidate dep cache hit for the binary
RUN touch packages/core-vm/src/lib.rs packages/node/src/main.rs

# Full release build
RUN cargo build --release -p utxo-vmd

# Verify the binary was produced
RUN ls -lh target/release/utxo-vmd

# ─────────────────────────────────────────────────────────────────
# Stage 2: Runtime — minimal production image
# ─────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

# Only ca-certs and curl needed for healthcheck and HTTPS calls to electrs
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the compiled binary from builder
COPY --from=builder /app/target/release/utxo-vmd /usr/local/bin/utxo-vmd

# Create persistent data directory
RUN mkdir -p /app/data && chmod 750 /app/data

# ── Runtime defaults (overridable via docker-compose environment) ──
ENV RUST_LOG=info
ENV CHAIN=JKC_TESTNET
ENV ELECTRS_URL=http://electrs:3000
ENV RPC_PORT=9773
ENV P2P_PORT=2232
ENV DATA_DIR=/app/data

EXPOSE 9773 2232

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:${RPC_PORT}/health || exit 1

ENTRYPOINT ["/usr/local/bin/utxo-vmd"]
CMD ["--chain", "JKC_TESTNET", "--rpc-port", "9773", "--p2p-port", "2232", "--data-dir", "/app/data"]
