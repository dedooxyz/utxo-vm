# UTXO-VM Indexer - App Configuration

# Chain to index (must exist in chain.json)
CHAIN=JKC_TESTNET

# Chain config file path (optional, defaults to ./chain.json)
CHAIN_CONFIG_PATH=./chain.json

# Override electrs URL (optional, uses chain.json default if not set)
# ELECTRS_URL=https://custom-electrs.example.com

# SQLite database path (optional)
DB_PATH=./data/indexer.db

# Sync interval in milliseconds (default: 30000 = 30s)
SYNC_INTERVAL_MS=30000

# Server port (default: 9773)
PORT=9773

# Node environment
NODE_ENV=production
